+/// TEMPORARY (research prototype): same semantics as [`glob_matches`] without
+/// cloning the memoized `GlobMatcher` or allocating the `./` variant per call.
+fn glob_matches_borrowed(pattern: &str, value: &str) -> bool {
+    static CACHE: OnceLock<RwLock<HashMap<String, Option<GlobMatcher>>>> = OnceLock::new();
+    let cache = CACHE.get_or_init(|| RwLock::new(HashMap::new()));
+    {
+        if let Ok(read) = cache.read()
+            && let Some(cached) = read.get(pattern)
+        {
+            return match cached {
+                Some(matcher) => {
+                    matcher.is_match(value) || {
+                        DOT_SLASH.with(|buf| {
+                            let mut buf = buf.borrow_mut();
+                            buf.clear();
+                            buf.push_str("./");
+                            buf.push_str(value);
+                            matcher.is_match(buf.as_str())
+                        })
+                    }
+                }
+                None => value.contains(pattern.trim_matches('*')),
+            };
+        }
+    }
+    let compiled = Glob::new(pattern).ok().map(|glob| glob.compile_matcher());
+    if let Ok(mut write) = cache.write() {
+        write.insert(pattern.to_string(), compiled);
+    }
+    glob_matches_borrowed(pattern, value)
+}
