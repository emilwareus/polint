{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/oaiz-io/polint/main/docs/schemas/polint-facts-v1.json",
  "title": "polint facts report v1",
  "type": "object",
  "required": ["version", "schema", "tool"],
  "properties": {
    "version": { "const": 1 },
    "schema": { "type": "string" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "polint" },
        "version": { "type": "string" }
      }
    },
    "views": { "type": "array" },
    "capability": { "type": "string" },
    "limit": { "type": "integer", "minimum": 0 },
    "sampled": { "type": "integer", "minimum": 0 },
    "rows": { "type": "array" }
  }
}
