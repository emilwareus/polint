package polint:rule;

interface host {
  type file-id = u32;
  type function-id = u64;
  type branch-id = u64;

  enum severity {
    info,
    warn,
    error,
  }

  record text-range {
    start-line: u32,
    start-col: u32,
    end-line: u32,
    end-col: u32,
  }

  record rule-metadata {
    id: string,
    description: string,
    severity: severity,
  }

  record diagnostic {
    rule-id: string,
    severity: severity,
    file: file-id,
    range: text-range,
    message: string,
    help: option<string>,
  }

  get-file-path: func(file: file-id) -> string;
  get-function-name: func(function: function-id) -> string;
  get-branch-condition: func(branch: branch-id) -> string;
  report: func(diagnostic: diagnostic);
}

world rule {
  import host;

  export metadata: func() -> host.rule-metadata;
  export capabilities: func() -> list<string>;
  export run: func();
}
